# Local demonstration settings only. Never reuse these on a public server.
DEMO_SEED=true
API_HOST=127.0.0.1
API_PORT=8787
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=tantan
MYSQL_PASSWORD=local-demo-db-password
MYSQL_DATABASE=tantan
ADMIN_USERNAME=admin
ADMIN_PASSWORD=local-demo-admin-password
AUTH_SECRET=local-demo-auth-secret-replace-before-deploy
ADMIN_TOKEN=local-demo-admin-token-replace-before-deploy
CLIENT_BASE_URL=http://localhost:3000
CORS_ORIGIN=http://localhost:3000,http://localhost:3001,http://localhost:3002
# Optional: the basic ordering flow does not require an AI key.
GEMINI_API_KEY=
# Optional S3-compatible object storage, needed for image/proof uploads.
RAINYUN_BUCKET=
RAINYUN_ENDPOINT=
RAINYUN_ACCESS_KEY=
RAINYUN_SECRET_KEY=
RAINYUN_PUBLIC_BASE=
RAINYUN_REGION=auto
